# ==============================================================================
# VoyagePilot AI - Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment system.
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
PORT=8080
SERVER_PORT=8080

# MongoDB Connection String (Defaults to local MongoDB instance)
MONGODB_URI=mongodb://localhost:27017/voyagepilot

# AI Provider Settings
# Options: 'gemini' (requires GEMINI_API_KEY) or 'fallback' (deterministic offline)
AI_PROVIDER=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Port
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
